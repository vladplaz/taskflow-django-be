# Copy to .env for local development. Read by both Django and Docker Compose;
# a real environment variable wins. prod.py refuses to boot without real
# secrets. DJANGO_SETTINGS_MODULE is absent by necessity: it must be set before
# Django imports the settings that load this file, so manage.py picks it.

# Django
DJANGO_SECRET_KEY=change-me-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO
DJANGO_DEVELOPMENT_LATENCY=false

# PostgreSQL (used by Docker Compose and Django)
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# The local container speaks no TLS; production defaults to "require".
POSTGRES_SSLMODE=prefer

# Redis (Channels, and the throttling cache in production)
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# A hosted Redis instead: paste its rediss:// URL above, or leave REDIS_URL
# unset and give REDIS_HOST / REDIS_PASSWORD / REDIS_USERNAME / REDIS_TLS /
# REDIS_DB. A provider's https:// REST endpoint is a different product and
# cannot carry WebSockets.

# Domain policy
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_DAYS=14
TASK_DESCRIPTION_MAX_BYTES=100000

# Attachments. Raise the reverse proxy's own ceiling to match (nginx: 1 MB).
ATTACHMENT_MAX_BYTES=26214400
ATTACHMENT_THUMBNAIL_MAX_PX=400
ATTACHMENT_THUMBNAIL_QUALITY=80
ATTACHMENT_URL_TTL_SECONDS=300
ATTACHMENT_UNCLAIMED_MAX_AGE_HOURS=6
DJANGO_MEDIA_ROOT=media

# S3 attachment storage. Naming a bucket switches uploads to S3 in any
# environment; blank keeps them on local disk. boto3 reads the credentials.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Endpoint and addressing style are for an S3-compatible service, not AWS.
# AWS_S3_ENDPOINT_URL=
# AWS_S3_ADDRESSING_STYLE=
#
# Cloudflare R2. The endpoint stops at the account host: R2's console appends
# the bucket, which would double the prefix on every key. An R2 token also
# shows a token value, unused here -- the secret access key is the S3 form of
# it, and AWS_SESSION_TOKEN means something else and breaks signing.
# AWS_STORAGE_BUCKET_NAME=taskflow-attachments
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
#
# The Floci emulator: docker compose --profile s3 up -d
# AWS_STORAGE_BUCKET_NAME=taskflow-attachments
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=http://localhost:4566
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_PORT=4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Rate limits. anon/user are the ceiling on every endpoint. DJANGO_NUM_PROXIES
# must match the proxies in front of Django, or a client spoofs its IP through
# X-Forwarded-For and skips the limit.
DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=2000/hour
DJANGO_THROTTLE_LOGIN=10/min
DJANGO_THROTTLE_REGISTER=20/hour
DJANGO_THROTTLE_INVITATION=60/hour
DJANGO_NUM_PROXIES=0

# Concurrent WebSockets one account may hold; 0 disables the cap.
DJANGO_WEBSOCKET_MAX_SOCKETS_PER_USER=20
